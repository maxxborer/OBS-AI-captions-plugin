{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 / OBS 32.2.1",
      "description": "Build AI Caption Plugin for the installed OBS 32.2.1 line",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "warnings": {
        "dev": true,
        "deprecated": true
      },
      "cacheVariables": {
        "BUILD_SHARED_LIBS": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64 RelWithDebInfo",
      "configuration": "RelWithDebInfo"
    }
  ]
}
